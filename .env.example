# Optional: News API key for live headlines (https://newsapi.org/)
NEWS_API_KEY=075b09320ef3460fb8550ae618ad242e

# Optional: Alpha Vantage API key for alternative financial data
ALPHA_VANTAGE_KEY=KQG0BPJLZ1QM04EJ

# Optional: OpenAI API key for future LLM-based reasoning (not required)
OPENAI_API_KEY=your_openai_api_key_here